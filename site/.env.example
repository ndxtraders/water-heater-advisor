# Copy to .env.local and fill in. Never commit .env.local.
#
# Every value below is read on the server only, with the single exception of
# NEXT_PUBLIC_SUPABASE_URL. Anything prefixed NEXT_PUBLIC_ is inlined into the
# JavaScript bundle at build time and served to every visitor, so the service
# role key must never carry that prefix.

# Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The `service_role` key, marked secret. Bypasses row level security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string: `openssl rand -hex 32`. Salts the IP hash used for
# rate limiting, so a raw IP is never stored.
SUBMISSION_IP_SALT=

# Resend — every lead sends an email. Missing keys do not block the insert;
# the lead is saved and the notification failure is logged.
#
# onboarding@resend.dev is Resend's shared test sender. It needs no domain and
# no DNS, but it can only deliver to the address the Resend account itself was
# opened with - which is why LEAD_NOTIFY_EMAIL below must match that account.
# Sending to anyone else (a contractor, a second inbox) is what requires
# verifying a real domain later.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=waterheateradvisor@gmail.com
LEAD_FROM_EMAIL=onboarding@resend.dev

# Twilio — urgent leads only. E.164 format for both numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
LEAD_NOTIFY_SMS=
