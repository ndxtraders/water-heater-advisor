# Copy to .env.local and fill in. Never commit .env.local.
#
# Every value below is read on the server only, with the single exception of
# NEXT_PUBLIC_SUPABASE_URL. Anything prefixed NEXT_PUBLIC_ is inlined into the
# JavaScript bundle at build time and served to every visitor, so the service
# role key must never carry that prefix.

# Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The `service_role` key, marked secret. Bypasses row level security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string: `openssl rand -hex 32`. Salts the IP hash used for
# rate limiting, so a raw IP is never stored.
SUBMISSION_IP_SALT=

# Resend — every lead sends an email. Missing keys do not block the insert;
# the lead is saved and the notification failure is logged.
#
# LEAD_FROM_EMAIL must be on a domain verified in Resend, e.g.
# results@waterheateradvisor.com. Resend's shared sender (onboarding@resend.dev)
# works without DNS but only delivers to the Resend account's own address, so it
# cannot reach homeowners. The sending domain needs no inbox: replies are
# steered to LEAD_NOTIFY_EMAIL by a Reply-To header, which is why Resend's
# receiving feature stays off and the domain's MX records stay free for a real
# mail provider.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=waterheateradvisor@gmail.com
LEAD_FROM_EMAIL=

# Twilio — urgent leads only. E.164 format for both numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
LEAD_NOTIFY_SMS=
